{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/queue-bulk.schema.json",
  "title": "QueueBulkAddRequest",
  "description": "Bulk add multiple tracks to the playback queue at once",
  "type": "object",
  "required": ["track_ids"],
  "additionalProperties": false,
  "properties": {
    "track_ids": {
      "type": "array",
      "description": "List of track IDs to add to the queue",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true
    }
  }
}
