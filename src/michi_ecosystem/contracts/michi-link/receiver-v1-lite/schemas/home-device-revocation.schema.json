{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/home-device-revocation.schema.json",
  "title": "HomeDeviceRevocation",
  "description": "Cryptographic revocation record for a removed or compromised device in a Michi Home.",
  "type": "object",
  "required": [
    "version",
    "home_id",
    "revoked_device_michi_id",
    "revoked_at",
    "reason",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "description": "Revocation schema version (always 1).",
      "enum": [
        1
      ]
    },
    "home_id": {
      "type": "string",
      "description": "Michi Home ID (43 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "revoked_device_michi_id": {
      "type": "string",
      "description": "Device michi_id being revoked (43 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "revoked_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of revocation.",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "description": "Revocation reason description.",
      "minLength": 1,
      "maxLength": 256
    },
    "signature": {
      "type": "string",
      "description": "Ed25519 signature by Home Root Authority over canonical revocation bytes (86 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
