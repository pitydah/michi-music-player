{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/sync-state-request.schema.json",
  "title": "SyncStateRequest",
  "description": "Upload sync state from a device (see MICHI_LINK_API_V1.md POST /sync/state)",
  "type": "object",
  "required": ["device_id"],
  "additionalProperties": false,
  "properties": {
    "device_id": { "type": "string", "minLength": 1, "description": "Device reporting its sync state" },
    "manifest_id": { "type": "string", "format": "uuid", "description": "ID of the manifest applied" },
    "synced_at": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp of the last sync" },
    "downloaded_tracks": {
      "type": "array",
      "description": "Tracks downloaded on this device",
      "items": { "type": "string", "minLength": 1 }
    },
    "storage_used_bytes": { "type": "integer", "minimum": 0, "description": "Storage used by synced content in bytes" },
    "track_id": { "type": "string", "minLength": 1 },
    "position_ms": { "type": "integer", "minimum": 0 },
    "playing": { "type": "boolean" },
    "volume": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
