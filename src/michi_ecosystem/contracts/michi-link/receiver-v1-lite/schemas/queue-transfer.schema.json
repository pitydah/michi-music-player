{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/queue-transfer.schema.json",
  "title": "QueueTransferRequest",
  "description": "Queue transfer request for Continue-on-Server handoff",
  "type": "object",
  "required": ["track_ids", "current_index", "position_ms", "source"],
  "additionalProperties": false,
  "properties": {
    "track_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "current_index": { "type": "integer", "minimum": 0 },
    "position_ms": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "queue_id": { "type": "string", "minLength": 1 }
  }
}
