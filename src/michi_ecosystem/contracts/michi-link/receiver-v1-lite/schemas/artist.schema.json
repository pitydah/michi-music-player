{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/artist.schema.json",
  "title": "Artist",
  "description": "A music artist or band entry in the library",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique artist identifier",
      "minLength": 1,
      "examples": ["artist_f1a2b3c4"]
    },
    "name": {
      "type": "string",
      "description": "Artist display name",
      "minLength": 1,
      "maxLength": 256,
      "examples": ["Queen"]
    },
    "album_count": {
      "type": "integer",
      "description": "Number of albums by this artist in the library",
      "minimum": 0,
      "examples": [15]
    },
    "track_count": {
      "type": "integer",
      "description": "Number of tracks by this artist in the library",
      "minimum": 0,
      "examples": [180]
    },
    "genres": {
      "type": "array",
      "description": "List of genres associated with this artist",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "examples": [["Rock", "Progressive Rock", "Hard Rock"]]
    },
    "artwork_id": {
      "type": "string",
      "description": "Reference to artist portrait or image",
      "examples": ["artwork_i9j0k1l2"]
    },
    "added_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the artist was added to the library",
      "format": "date-time",
      "examples": ["2025-06-01T12:00:00Z"]
    }
  }
}
