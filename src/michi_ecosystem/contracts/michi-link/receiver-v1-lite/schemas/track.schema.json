{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/track.schema.json",
  "title": "Track",
  "description": "A single audio track entry in the library. File locations are NOT part of the contract: audio URLs are resolved via the streaming endpoints (see /api/v1/tracks), artwork via artwork_id.",
  "type": "object",
  "required": ["id", "title", "artist", "album", "duration_ms"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique track identifier",
      "minLength": 1,
      "examples": ["track_9a8b7c6d"]
    },
    "title": {
      "type": "string",
      "description": "Track title",
      "minLength": 1,
      "maxLength": 512,
      "examples": ["Bohemian Rhapsody"]
    },
    "artist": {
      "type": "string",
      "description": "Primary artist name",
      "minLength": 1,
      "maxLength": 256,
      "examples": ["Queen"]
    },
    "album": {
      "type": "string",
      "description": "Album name",
      "maxLength": 256,
      "examples": ["A Night at the Opera"]
    },
    "duration_ms": {
      "type": "integer",
      "description": "Track duration in milliseconds",
      "minimum": 0,
      "examples": [354000]
    },
    "track_number": {
      "type": "integer",
      "description": "Track number on the disc",
      "minimum": 1,
      "examples": [1]
    },
    "disc_number": {
      "type": "integer",
      "description": "Disc number in a multi-disc release",
      "minimum": 1,
      "default": 1,
      "examples": [1]
    },
    "year": {
      "type": "integer",
      "description": "Release year",
      "minimum": 1,
      "maximum": 2100,
      "examples": [1975]
    },
    "genre": {
      "type": "string",
      "description": "Primary genre tag",
      "maxLength": 128,
      "examples": ["Rock"]
    },
    "format": {
      "type": "string",
      "description": "Audio file format",
      "enum": ["flac", "mp3", "aac", "ogg", "wav", "aiff", "dsf", "dff", "wma", "alac", "opus"]
    },
    "bitrate": {
      "type": "integer",
      "description": "Bitrate in kbps",
      "minimum": 0,
      "examples": [1411]
    },
    "sample_rate": {
      "type": "integer",
      "description": "Sample rate in Hz",
      "minimum": 8000,
      "maximum": 384000,
      "examples": [44100]
    },
    "channels": {
      "type": "integer",
      "description": "Number of audio channels",
      "minimum": 1,
      "maximum": 8,
      "examples": [2]
    },
    "size_bytes": {
      "type": "integer",
      "description": "File size in bytes",
      "minimum": 0,
      "examples": [12345678]
    },
    "md5_hash": {
      "type": "string",
      "description": "MD5 checksum of the audio file",
      "pattern": "^[a-fA-F0-9]{32}$",
      "examples": ["d41d8cd98f00b204e9800998ecf8427e"]
    },
    "added_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the track was added to the library",
      "format": "date-time",
      "examples": ["2025-06-01T12:00:00Z"]
    },
    "modified_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the track metadata was last modified",
      "format": "date-time",
      "examples": ["2025-06-15T08:30:00Z"]
    },
    "artwork_id": {
      "type": "string",
      "description": "Reference to the artwork image",
      "examples": ["artwork_a1b2c3d4"]
    }
  }
}
