{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/michi-membership.schema.json",
  "title": "MichiMembership",
  "description": "Cryptographic membership certificate issued to a device by the Home Root Authority.",
  "type": "object",
  "required": [
    "version",
    "home_id",
    "device_michi_id",
    "device_public_key",
    "device_type",
    "roles",
    "issued_at",
    "serial",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "description": "Membership certificate version (always 1).",
      "enum": [
        1
      ]
    },
    "home_id": {
      "type": "string",
      "description": "Michi Home ID that issued this certificate (43 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "device_michi_id": {
      "type": "string",
      "description": "Device cryptographic identity (43 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "device_public_key": {
      "type": "string",
      "description": "Device Ed25519 public key (43 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "device_type": {
      "type": "string",
      "description": "Device type in the home ecosystem.",
      "enum": [
        "player",
        "server",
        "stream",
        "mobile"
      ]
    },
    "roles": {
      "type": "array",
      "description": "Authorized roles granted to the device in this home.",
      "items": {
        "type": "string",
        "enum": [
          "desktop_player",
          "library_master",
          "sync_host",
          "music_server",
          "library_host",
          "playback_host",
          "mobile_player",
          "remote_controller",
          "sync_client",
          "audio_receiver"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of issuance.",
      "format": "date-time"
    },
    "serial": {
      "type": "integer",
      "description": "Monotonically increasing issuance serial number within the home.",
      "minimum": 1
    },
    "signature": {
      "type": "string",
      "description": "Ed25519 signature by Home Root Authority over canonical membership bytes (86 chars base64url).",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
