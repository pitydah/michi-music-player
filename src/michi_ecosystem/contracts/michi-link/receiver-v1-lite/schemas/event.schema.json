{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/event.schema.json",
  "title": "Event",
  "description": "WebSocket event envelope for real-time communication",
  "type": "object",
  "required": ["type", "data", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "description": "Event type identifier. Contractual types are defined in EVENTS.md.",
      "enum": ["playback.state_changed"],
      "examples": ["playback.state_changed"]
    },
    "data": {
      "type": "object",
      "description": "Event-specific payload data",
      "additionalProperties": true
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when the event was generated",
      "format": "date-time",
      "examples": ["2026-06-29T12:00:00Z"]
    }
  }
}
