{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/playlist.schema.json",
  "title": "Playlist",
  "description": "A user-defined or curated playlist",
  "type": "object",
  "required": ["id", "name", "tracks"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique playlist identifier",
      "minLength": 1,
      "examples": ["playlist_m3n4o5p6"]
    },
    "name": {
      "type": "string",
      "description": "Playlist display name",
      "minLength": 1,
      "maxLength": 256,
      "examples": ["Road Trip Mix"]
    },
    "description": {
      "type": "string",
      "description": "Optional description of the playlist",
      "maxLength": 1024,
      "examples": ["Songs for long drives"]
    },
    "owner": {
      "type": "string",
      "description": "Owner identifier (user or device)",
      "maxLength": 128,
      "examples": ["user_abc123"]
    },
    "track_count": {
      "type": "integer",
      "description": "Number of tracks in the playlist",
      "minimum": 0,
      "examples": [42]
    },
    "duration_ms": {
      "type": "integer",
      "description": "Total duration of all tracks in milliseconds",
      "minimum": 0,
      "examples": [7200000]
    },
    "is_public": {
      "type": "boolean",
      "description": "Whether the playlist is publicly visible",
      "default": false
    },
    "tracks": {
      "type": "array",
      "description": "Ordered list of track identifiers",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "examples": [["track_1", "track_2", "track_3"]]
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the playlist was created",
      "format": "date-time",
      "examples": ["2025-06-10T14:30:00Z"]
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the playlist was last modified",
      "format": "date-time",
      "examples": ["2025-06-20T09:15:00Z"]
    }
  }
}
