{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/qr-pairing.schema.json",
  "title": "QrPairing",
  "description": "JSON payload embedded in the pairing QR code, generated by the Rust crate. uri is the michi:// pair URI the QR encodes.",
  "type": "object",
  "required": ["uri", "format", "version", "server_michi_id", "server_public_key", "session_id", "expires_at", "endpoint"],
  "additionalProperties": false,
  "properties": {
    "uri": {
      "type": "string",
      "description": "Canonical michi pair URI",
      "pattern": "^michi://pair\\?",
      "examples": ["michi://pair?v=1&s=a1b2c3d4-e5f6-7890-abcd-ef1234567890"]
    },
    "format": {
      "type": "string",
      "description": "QR payload format identifier",
      "enum": ["michi-link-pairing"],
      "examples": ["michi-link-pairing"]
    },
    "version": {
      "type": "integer",
      "description": "Payload schema version",
      "enum": [1],
      "examples": [1]
    },
    "server_michi_id": {
      "type": "string",
      "description": "Server identity derived as base64url(BLAKE3(public_key)), exactly 43 chars, no padding",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "examples": ["QlGQosQszLQse057MCaw32IAHXv-I5klmAAsbivIays"]
    },
    "server_public_key": {
      "type": "string",
      "description": "Server Ed25519 public key in base64url, exactly 43 chars, no padding",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "examples": ["KJN5aOu4gWhA0clmvmwqprYcwYI013vDNPx1jf90CpQ"]
    },
    "session_id": {
      "type": "string",
      "description": "Pairing session identifier",
      "format": "uuid",
      "examples": ["a1b2c3d4-e5f6-7890-abcd-ef1234567890"]
    },
    "expires_at": {
      "type": "string",
      "description": "Payload expiry timestamp (RFC 3339)",
      "format": "date-time",
      "examples": ["2026-08-05T10:05:00Z"]
    },
    "endpoint": {
      "type": "string",
      "description": "Server API endpoint the client should contact",
      "pattern": "^https?://",
      "examples": ["http://192.168.1.100:8400"]
    }
  }
}
