{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/device-info.schema.json",
  "title": "DeviceInfo",
  "description": "Information about a paired device",
  "type": "object",
  "required": ["device_id", "name", "device_type"],
  "additionalProperties": false,
  "properties": {
    "device_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "device_type": {
      "type": "string",
      "description": "Device type",
      "enum": ["mobile", "desktop", "receiver"]
    },
    "roles": {
      "type": "array",
      "description": "Active roles for this device",
      "items": {
        "type": "string",
        "enum": ["desktop_player", "library_master", "sync_host", "music_server", "library_host", "playback_host", "mobile_player", "remote_controller", "sync_client", "audio_receiver"]
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "description": "Granted permission identifiers",
      "items": { "type": "string", "minLength": 1 }
    },
    "last_seen": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
