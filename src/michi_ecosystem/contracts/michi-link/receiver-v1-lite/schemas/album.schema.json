{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/album.schema.json",
  "title": "Album",
  "description": "A music album grouping tracks by release",
  "type": "object",
  "required": ["id", "title", "artist"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique album identifier",
      "minLength": 1,
      "examples": ["album_7b8c9d0e"]
    },
    "title": {
      "type": "string",
      "description": "Album title",
      "minLength": 1,
      "maxLength": 512,
      "examples": ["A Night at the Opera"]
    },
    "artist": {
      "type": "string",
      "description": "Primary artist or album artist",
      "minLength": 1,
      "maxLength": 256,
      "examples": ["Queen"]
    },
    "year": {
      "type": "integer",
      "description": "Release year",
      "minimum": 1,
      "maximum": 2100,
      "examples": [1975]
    },
    "genre": {
      "type": "string",
      "description": "Primary genre",
      "maxLength": 128,
      "examples": ["Rock"]
    },
    "track_count": {
      "type": "integer",
      "description": "Number of tracks in the album",
      "minimum": 0,
      "examples": [12]
    },
    "duration_ms": {
      "type": "integer",
      "description": "Total duration of all tracks in milliseconds",
      "minimum": 0,
      "examples": [2580000]
    },
    "artwork_id": {
      "type": "string",
      "description": "Reference to the cover artwork image",
      "examples": ["artwork_e5f6g7h8"]
    },
    "added_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the album was added to the library",
      "format": "date-time",
      "examples": ["2025-06-01T12:00:00Z"]
    }
  }
}
