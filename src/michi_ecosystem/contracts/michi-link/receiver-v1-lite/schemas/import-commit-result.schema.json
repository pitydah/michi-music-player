{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/import-commit-result.schema.json",
  "title": "ImportCommitResult",
  "description": "Result of an import commit operation, including track mapping between source and server",
  "type": "object",
  "required": ["session_id", "tracks_imported", "total_tracks", "mapping"],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "description": "The import session ID",
      "format": "uuid"
    },
    "tracks_imported": {
      "type": "integer",
      "description": "Number of new tracks imported",
      "minimum": 0
    },
    "tracks_skipped": {
      "type": "integer",
      "description": "Number of duplicate tracks skipped",
      "minimum": 0
    },
    "total_tracks": {
      "type": "integer",
      "description": "Total tracks in the session (imported + skipped)",
      "minimum": 0
    },
    "mapping": {
      "type": "array",
      "description": "Track mapping entries (official format)",
      "items": {
        "type": "object",
        "required": ["local_track_id", "remote_track_id", "status"],
        "additionalProperties": false,
        "properties": {
          "local_track_id": { "type": "string", "minLength": 1 },
          "remote_track_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["uploaded", "already_present"] },
          "match": { "type": "string", "enum": ["exact_hash", "quick_hash", "metadata_duration", "none"] }
        }
      }
    },
    "mapping_legacy": {
      "type": "object",
      "description": "Legacy mapping format (local_id → remote_id). Deprecated.",
      "additionalProperties": { "type": "string" }
    }
  }
}
