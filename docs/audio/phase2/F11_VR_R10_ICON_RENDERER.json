  "root_cause": {
    "primary": "The inherited stage icon rendered 24x24 Tabler paths through a manual uniform Scale into 20x20 logical pixels and relied on the default Shape renderer.",
    "secondary": "PySide6's bundled Qt 6.11.1 does not ship the QtQuick.VectorImage QML module; the system Qt installation does, but the application process uses the PySide6 module set.",
    "result": "GeometryRenderer tessellation plus non-integer stroke scaling produced soft/uneven small glyphs."
  },
  "solution": {
    "renderer": "QtQuick.Shapes Shape.CurveRenderer",
    "icon_size": 24,
    "grid": 24,
    "stroke_width": 2.0,
    "manual_scale": false,
    "vector_image": "UNAVAILABLE_IN_PYSIDE6_RUNTIME",
    "assets": "src/michi/resources/icons/tabler/"
  },
